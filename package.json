{
  "name": "remove-credential",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Host plugin that replaces .env values with their key names before the model sees them.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./redact": "./lib/redact.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
